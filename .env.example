# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored -- keep it that way.
# Nothing here belongs in config/config.yaml.
# ---------------------------------------------------------------------------

# --- v2: クラウド実行（GitHub Actions）--------------------------------------
# 本番ではここではなく GitHub の Settings → Secrets and variables → Actions に置く。
# ローカルで `python -m aiworker.cloud run` を試すときだけ .env に書く。
# 変数（公開してよい）: SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / AIWORKER_OWNER_ID
# シークレット（絶対に公開しない）: SUPABASE_SECRET_KEY / GEMINI_API_KEY / CLOUDFLARE_*
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AIWORKER_OWNER_ID=
# Google AI Studio の無料APIキー（課金は有効にしない）
GEMINI_API_KEY=
# 省略時: gemini / cloudflare。オフラインで試すなら mock
AIWORKER_LLM=gemini
AIWORKER_IMAGE=cloudflare

# --- LLM -------------------------------------------------------------------
# Only needed when generation.provider is `anthropic`.
# With `claude_cli` the local `claude` binary supplies its own credentials,
# and with `mock` nothing is needed at all.
ANTHROPIC_API_KEY=

# --- alerting --------------------------------------------------------------
# At least one of these should be set before you run unattended, otherwise an
# auto-halt only ever reaches the console of a machine nobody is watching.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- 画像生成（ストック素材）-----------------------------------------------
# image.provider が 'cloudflare' のとき必要。無料枠・カード不要・GPU不要。
# https://dash.cloudflare.com → AI → Workers AI でトークンを発行
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# image.provider が 'local'（自分のPCのStable Diffusion）のとき
LOCAL_IMAGE_ENDPOINT=http://127.0.0.1:7860/sdapi/v1/txt2img

# --- publishing adapters ---------------------------------------------------
# Leave blank while `publisher: manual`. Fill in only for a platform you have
# read the developer terms of and are authorised to post to programmatically.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- revenue import --------------------------------------------------------
# A8.net has no public REST API for affiliate reporting: revenue is imported
# from the CSV you download from the management console.
A8_CSV_DIR=

# --- misc ------------------------------------------------------------------
# Override the config file path if you keep several environments side by side.
# AIWORKER_CONFIG=config/config.production.yaml
