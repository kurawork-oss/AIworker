# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored -- keep it that way.
# Nothing here belongs in config/config.yaml.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Only needed when generation.provider is `anthropic`.
# With `claude_cli` the local `claude` binary supplies its own credentials,
# and with `mock` nothing is needed at all.
ANTHROPIC_API_KEY=

# --- alerting --------------------------------------------------------------
# At least one of these should be set before you run unattended, otherwise an
# auto-halt only ever reaches the console of a machine nobody is watching.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- publishing adapters ---------------------------------------------------
# Leave blank while `publisher: manual`. Fill in only for a platform you have
# read the developer terms of and are authorised to post to programmatically.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- revenue import --------------------------------------------------------
# A8.net has no public REST API for affiliate reporting: revenue is imported
# from the CSV you download from the management console.
A8_CSV_DIR=

# --- misc ------------------------------------------------------------------
# Override the config file path if you keep several environments side by side.
# AIWORKER_CONFIG=config/config.production.yaml
